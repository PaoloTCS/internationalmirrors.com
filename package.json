{
  "name": "internationalmirrors",
  "version": "1.0.0",
  "description": "International Mirrors research site for integrity in societies of AI agents",
  "scripts": {
    "dev": "live-server --port=8080 --open=/index.html",
    "build": "node scripts/build.mjs",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,json,md}\"",
    "lint:html": "htmlhint index.html archive/index.html notes/*.html research/*.html protocols/*.html responses/*.html results/*.html",
    "lint:css": "stylelint \"**/*.css\"",
    "deploy": "npm run build && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PaoloTCS/internationalmirrors.com.git"
  },
  "keywords": [
    "ai-agents",
    "integrity",
    "multi-agent-systems",
    "research"
  ],
  "author": "Paolo Pignatelli",
  "license": "MIT",
  "devDependencies": {
    "live-server": "^1.2.2",
    "prettier": "^3.0.0",
    "htmlhint": "^1.1.4",
    "stylelint": "^15.10.0",
    "stylelint-config-standard": "^34.0.0",
    "clean-css-cli": "^5.6.2",
    "html-minifier": "^4.0.0",
    "gh-pages": "^6.0.0"
  }
}
